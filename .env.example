# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string
DATABASE_URL="postgresql://ngx_user:ngx_password@localhost:5432/ngx_pos_erp?schema=public"

# Session/auth secret — generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-value"

# Node environment
NODE_ENV="development"
